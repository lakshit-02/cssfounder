{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:create": "node prisma/create-db.js",
    "db:migrate-admin": "node prisma/migrate-user-to-admin.js",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "npm run db:create && prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "npm run db:create && npm run db:migrate-admin && prisma db push --accept-data-loss",
    "db:setup": "npm run db:create && npm run db:migrate-admin && prisma db push --accept-data-loss && prisma generate",
    "db:seed:categories": "node prisma/seed-categories.js",
    "db:seed:layouts": "node prisma/seed-layouts.js",
    "db:seed:coolfix-layouts": "node prisma/seed-coolfix-layouts.js",
    "db:seed:coolfix-template": "node prisma/seed-coolfix-template.js",
    "db:seed:realestate-layouts": "node prisma/seed-realestate-layouts.js",
    "db:seed:industry-layouts": "node prisma/seed-industry-layouts.js",
    "db:seed:beauty-layouts": "node prisma/seed-beauty-layouts.js",
    "db:seed:beauty-template": "node prisma/seed-beauty-template.js",
    "db:seed:health-layouts": "node prisma/seed-health-layouts.js",
    "db:seed:health-template": "node prisma/seed-health-template.js",
    "db:seed:automotive-layouts": "node prisma/seed-automotive-layouts.js",
    "db:seed:automotive-template": "node prisma/seed-automotive-template.js",
    "db:seed:templates": "node prisma/seed-templates.js",
    "db:seed:home-templates": "node prisma/seed-home-templates-for-categories.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.3",
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.32",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
